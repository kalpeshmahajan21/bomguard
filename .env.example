# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=your_token_factory_key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs — copy the EXACT ids from the Token Factory catalog
# (run: python scripts/check_setup.py  — it prints every Nemotron id it finds)
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_EXTRACT=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
MODEL_REASON=nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B

# Tavily
TAVILY_API_KEY=your_tavily_key

# Parallel part research (keep low on free credits)
CONCURRENCY=6

# MOCK=1 runs the whole UI with fake data, no keys needed (for UI work / video takes)
MOCK=0
